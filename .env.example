# Names only. Real values live in Vercel (Production and Preview) and are never committed.

# --- Phone notifications (web push) ---
# One key pair for the whole app. Make one with:  npx web-push generate-vapid-keys
# The public key is given to the browser by /api/push/prefs, so no NEXT_PUBLIC_ copy is needed.
VAPID_PUBLIC_KEY=
# Server only. Whoever holds it can send notifications as this app.
VAPID_PRIVATE_KEY=
# A contact address push services can reach about this sender, as mailto:you@example.com
VAPID_SUBJECT=
